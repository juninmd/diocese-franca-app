# Exemplo de configuração da API
# Copie este arquivo para .env no diretório backend se precisar customizar

# Porta do servidor (padrão: 3000)
PORT=3000

# Ambiente de execução ('development' habilita mensagens detalhadas em respostas HTTP; em produção ou sem a variável, o servidor retorna mensagens genéricas por segurança)
NODE_ENV=development

# Configuração do 'trust proxy' do Express quando a API roda atrás de um proxy reverso/load balancer (ex.: true, false, 1, 'loopback')
TRUST_PROXY=
